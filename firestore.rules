rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Bootstrap rule: authenticated users can read/write sales only.
    // Replace with role-based checks backed by a trusted custom claim or protected user profile
    // before using with real business data. Do not deploy permissive rules to production.
    match /sales/{saleId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
